# Copy to .env and adjust. All variables are optional; defaults are in config.py.

# --- Embeddings (openai, or ollama for a local daemon) ---
FAQRAG_EMBEDDING_PROVIDER=openai
FAQRAG_EMBEDDING_MODEL=text-embedding-3-large
FAQRAG_EMBEDDING_BATCH_SIZE=64

# --- Vector store: numpy (file-backed, zero-dep) or chroma ---
FAQRAG_VECTOR_STORE=numpy

# --- Retrieval ---
FAQRAG_TOP_K=5
FAQRAG_CANDIDATE_K=20
FAQRAG_FUSION_METHOD=rrf
FAQRAG_MIN_RELEVANCE_SCORE=0.45

# --- Reranking (set to false to save one LLM round-trip per query) ---
FAQRAG_RERANK_ENABLED=true
FAQRAG_RERANK_MAX_TOKENS=4096

# --- Generation (answering + reranking) ---
FAQRAG_LLM_PROVIDER=anthropic
FAQRAG_LLM_MODEL=claude-haiku-4-5

# Answer voice: saudi (dialect, human tone) or msa (formal standard Arabic)
FAQRAG_ANSWER_STYLE=saudi

# --- Chat UI (optional add-on; see web/README.md to remove it entirely) ---
FAQRAG_ENABLE_CHAT_UI=true

# --- API keys (both required by the defaults above) ---
FAQRAG_OPENAI_API_KEY=
FAQRAG_ANTHROPIC_API_KEY=

# --- Only needed when a provider above is set to ollama ---
# FAQRAG_OLLAMA_BASE_URL=http://localhost:11434
